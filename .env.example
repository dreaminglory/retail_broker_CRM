NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Public base URL of the app, used in invitation and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (AD-042). Local: MAIL_TRANSPORT=smtp sends to Mailpit (SMTP_HOST / SMTP_PORT default
# to 127.0.0.1:54325). Production: MAIL_TRANSPORT=resend with a verified sending domain.
MAIL_TRANSPORT=smtp
EMAIL_FROM=BrokerCRM <no-reply@example.com>
RESEND_API_KEY=
# Bearer secret for /api/cron/daily-digest. While it is unset the route refuses every call,
# which is how the schedule stays off until go-live.
CRON_SECRET=
